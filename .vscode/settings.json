{
  "editor.wordWrap": "on",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "[markdown]": {
    "files.trimTrailingWhitespace": false
  },
  "remote.autoForwardPortsFallback": 0,
  "geminicodeassist.project": "gen-lang-client-0464475716",

  // --- INTERPRETADOR PYTHON ---
  // Opção 1: Windows Local (Ativa agora)
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",

  // Opção 2: Codespaces / Linux (Comentada)
  // "python.defaultInterpreterPath": "/workspaces/AI-Engineering-Curriculum/.venv/bin/python",
  // ----------------------------

  "ruff.enable": true,
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",
  "editor.defaultFormatter": "charliermarsh.ruff"
}
