# Environment Configuration Template
# Copy to .env and update values as needed

# API
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Database
DATABASE_URL=postgresql://postgres:devpass@db:5432/bps_dev
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://cache:6379/0
CACHE_TTL=3600

# Observability
ENABLE_METRICS=true
ENABLE_TRACING=true
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Security
REQUIRE_API_KEY=false
API_KEY=dev-change-in-prod
