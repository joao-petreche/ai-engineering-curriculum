  "postCreateCommand": "sudo npm install -g @anthropic-ai/claude-code && [ -f \"$HOME/google-cloud-sdk/path.bash.inc\" ] && source \"$HOME/google-cloud-sdk/path.bash.inc\" || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "github.copilot-chat",
        // "google.geminicodeassist",
        "anthropic.claude-code",
        "bigladder.energyplus-modelkit",
        "charliermarsh.ruff",
        "ms-toolsai.datawrangler"
      ]
    }
  }
}
